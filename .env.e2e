# Loaded by `vite --mode e2e` (npm run dev:e2e). The stubbed Cypress suite
# answers every API call with cy.intercept, so the app talks to a host that
# does not exist: an unstubbed request fails instead of reaching a backend.
# Keep in sync with STUB_API_URL in cypress.config.ts.
VITE_API_BASE_URL=http://api.e2e.test
