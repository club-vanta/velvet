{
  "name": "alter-tracker-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "start-server-and-test dev:e2e http://localhost:5200 cy:run:e2e",
    "check": "npm run typecheck && prettier --check . && eslint .",
    "generate:api": "openapi-typescript https://raw.githubusercontent.com/club-vanta/alter-tracker-backend/refs/heads/main/openapi.json -o src/api/types.ts && prettier --write src/api/types.ts",
    "dev:e2e": "vite --mode e2e --port 5200 --strictPort",
    "dev:smoke": "vite --mode smoke --port 5200 --strictPort",
    "cy:open": "cypress open",
    "cy:run:e2e": "cypress run --e2e",
    "test:ct": "cypress run --component",
    "test:smoke": "CYPRESS_SMOKE=1 start-server-and-test dev:smoke http://localhost:5200 \"cypress run --e2e --spec cypress/e2e/smoke/** --expose apiUrl=http://localhost:8000,realBackend=true\"",
    "test:coverage": "vitest run --coverage",
    "cy:coverage": "VITE_COVERAGE=true npm run test:e2e && VITE_COVERAGE=true npm run test:ct",
    "coverage": "rm -rf .nyc_output coverage && npm run test:coverage && npm run cy:coverage && node scripts/merge-coverage.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bybas/weather-icons": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cypress/code-coverage": "^4.1.3",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^16.2.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod": "^4.6.7",
      "zod-validation-error": "^4.0.2"
    },
    "cypress-axe": {
      "cypress": "$cypress"
    }
  }
}
